# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Build artifacts (PyInstaller); the installers' spec is kept
build/
dist/
*.spec
!packaging/MedSearch.spec
*.egg-info/

# Icon previews written by the render_*.py scripts
*_preview.png

# Runtime logs
*.log

# macOS
.DS_Store

# Editor and Claude Code settings: local permissions, never published
.idea/
.claude/

# Test cache
.pytest_cache/

# iOS build (Briefcase): the generated Xcode project and the simulator logs
ios/build/
ios/logs/
ios/.briefcase/

# The Mac provisioning probe (packaging/macsign): its generated Xcode project
packaging/macsign/build/
packaging/macsign/logs/
packaging/macsign/.briefcase/
