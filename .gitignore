*_preview.png

# Runtime logs
.medsearch_app.log
*.log

# macOS
.DS_Store

# Marks the development clone: never offered the move to the installed app
.development

# User exports (created at runtime)
medsearch_exports/

# Test cache
.pytest_cache/
