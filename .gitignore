# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Build artifacts (PyInstaller); the installers' spec is kept
build/
dist/
*.spec
!packaging/MedSearch.spec
*.egg-info/

